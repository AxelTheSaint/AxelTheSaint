{# ===========================================================================
   {{ system.designation }}
   Template della console. Compilato da scripts/build.py — NON modificare il
   README.md generato: le modifiche vanno qui o in data/profile.yml.

   Ogni pannello ha due livelli:
     - VISIVO   : lo <picture> con gli SVG (identita', 4 varianti per pannello)
     - SEMANTICO: il Markdown sotto, in <details> (accessibilita', ricerca,
                  copia-incolla, e cio' che resta se le immagini non caricano)
   Non rimuovere il secondo perche' "e' gia' nell'immagine".
   =========================================================================== #}
{% macro pane(name, alt) -%}
<p align="center">
  <picture>
    <source media="(max-width: 600px) and (prefers-color-scheme: dark)" srcset="./assets/readme/{{ name }}-mobile-dark.svg?v={{ assets_rev }}">
    <source media="(max-width: 600px)" srcset="./assets/readme/{{ name }}-mobile-light.svg?v={{ assets_rev }}">
    <source media="(prefers-color-scheme: dark)" srcset="./assets/readme/{{ name }}-desktop-dark.svg?v={{ assets_rev }}">
    <img src="./assets/readme/{{ name }}-desktop-light.svg?v={{ assets_rev }}" width="100%" alt="{{ alt }}">
  </picture>
</p>
{%- endmacro %}
<!--
  {{ system.designation }}
  Generato da scripts/build.py a partire da data/profile.yml — non modificare a mano.
-->

{{ pane("01-hero", identity.name ~ " — " ~ identity.role ~ ". Mission-control console showing an architecture-first focus across backend, infrastructure, embedded systems and local AI.") }}

<p align="center">
{% for domain in identity.domains %}
  <code>{{ domain }}</code>{% if not loop.last %}&nbsp;·&nbsp;{% endif %}

{% endfor %}
</p>

{# I link devono stare QUI, nel Markdown: dentro un SVG servito come immagine
   gli <a> non sono cliccabili. Le icone sono solo la superficie visiva. #}
<p align="center">{% for channel in channels if channel.url %}<a href="{{ channel.url }}" title="{{ channel.alt }}"><picture><source media="(prefers-color-scheme: dark)" srcset="./assets/icons/{{ channel.key }}-dark.svg?v={{ assets_rev }}"><img src="./assets/icons/{{ channel.key }}-light.svg?v={{ assets_rev }}" width="74" height="46" alt="{{ channel.alt }}"></picture></a>{% endfor %}</p>

